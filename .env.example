# Export these values in your shell; .env is not loaded automatically.
OPENROUTER_API_KEY=replace-with-your-api-key
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
# local avoids embedding API calls; chat calls still use your configured API.
EMBED_BACKEND=local
# Used when EMBED_BACKEND=openai:
# EMBED_BASE_URL=https://api.openai.com/v1/embeddings
# EMBED_MODEL=text-embedding-3-small
